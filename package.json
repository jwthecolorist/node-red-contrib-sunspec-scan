    "prepublishOnly": "npm test"
  },
  "keywords": [
    "node-red",
    "sunspec",
    "modbus",
    "pv",
    "solar",
    "inverter",
    "storage"
  ],
  "author": "JW The Colorist",
  "license": "ISC",
  "type": "commonjs",
  "files": [
    "sunspec-scan.js",
    "sunspec-scan.html",
    "sunspec-client.js",
    "connection-manager.js",
    "device-manager.js",
    "discovery.js",
    "constants.js",
    "errors.js",
    "utils.js",
    "models/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "fs-extra": "^11.3.3",
    "modbus-serial": "^8.0.23"
  },
  "node-red": {
    "nodes": {
      "sunspec-scan": "sunspec-scan.js"
    }
  },
  "devDependencies": {
    "jest": "^30.2.0"
