{
  "name": "node-red-contrib-sunspec-scan",
  "version": "1.4.0",
  "description": "A Node-RED node for scanning, discovering, and reading/writing to SunSpec Modbus devices (inverters, storage, meters). Supports auto-discovery and scaling.",
  "main": "sunspec-scan.js",
  "scripts": {
